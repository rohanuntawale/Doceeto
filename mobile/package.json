{
  "name": "doceeto-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:install": "npm run android:build && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/app": "6.0.2",
    "@capacitor/browser": "6.0.4",
    "@capacitor/core": "6.1.2",
    "@capacitor/preferences": "6.0.2",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "6.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
