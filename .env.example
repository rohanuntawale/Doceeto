# ─────────────────────────────────────────────────────────────
# Iyashi — environment
# Copy to `.env.local` and fill in. The app RUNS WITHOUT any of these
# (local mode: in-browser store, zero setup, starts EMPTY — no demo
# data anywhere). Add the Neo4j block below to switch to the real
# backend with accounts and login.
# ─────────────────────────────────────────────────────────────

# Turn on server-backed live mode (accounts, login, real sessions).
# Leave unset for demo mode.
NEXT_PUBLIC_BACKEND=server

# Postgres connection (server-only — never exposed to the browser).
# Neon: https://neon.tech — copy the pooled connection string.
# Supabase or any other Postgres works with the same variable.
#
# THIS is what picks the database: set DATABASE_URL and every read, write and
# session goes to Postgres. Leave it empty and the app falls back to the
# zero-setup file store at .data/iyashi.json (fine for a single machine,
# useless across instances).
DATABASE_URL=

# Optional: cap the local connection pool (default 5). Keep it small on a free
# Neon project, which allows few concurrent connections.
PGPOOL_MAX=

# ── Migrating off Neo4j? ──────────────────────────────────────
# These are read ONLY by scripts/migrate-neo4j-to-postgres.mjs, never by the
# app. Set them alongside DATABASE_URL, run the migration once, then delete.
#   npm run db:migrate:neo4j-to-postgres -- --dry-run
#   npm run db:migrate:neo4j-to-postgres
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# One-time setup token — required to call POST /api/admin/seed, which creates
# the constraints (including the Session ones) and the ops login. Run it once
# against a fresh database before signing in.
SETUP_TOKEN=

# Google sign-in (optional). Create an OAuth 2.0 Client ID of type
# "Web application" at https://console.cloud.google.com/apis/credentials
# and register these Authorised redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
# The client id is public (it travels in the URL to Google); only the
# secret must stay server-side. Leave both unset to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seeded ops (admin) login, created by the setup route.
OPS_EMAIL=ops@iyashi.health
OPS_PASSWORD=change-me

# Canonical app URL (used for links). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Maps — both optional, both worth setting before launch.
# ─────────────────────────────────────────────────────────────

# Vector basemap (MapTiler). Free tier at https://cloud.maptiler.com/account/keys.
# WITHOUT it the maps still work: MapLibre falls back to CARTO's free dark
# raster tiles. WITH it you get vector tiles — upright labels on a rotated map,
# crisp roads at every zoom, and a basemap that can be tilted, which is what
# makes the live-trip view read like a navigation screen rather than a diagram.
# The key is public by design (it travels in every tile request), so restrict
# it by HTTP referrer in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=

# Driving directions (OSRM). Powers the road-following route line and the ETA
# on the live-trip map. Defaults to OSRM's PUBLIC DEMO SERVER, which has no SLA
# and a fair-use policy — fine for development, NOT for production traffic.
# Before launch, run your own: `osrm/osrm-backend` over an India OSM extract,
# or any OSRM-compatible host. Leave empty and routing degrades to a straight
# line with a distance-based ETA; nothing breaks.
OSRM_URL=

# ─────────────────────────────────────────────────────────────
# AI symptom checker (OpenRouter) — optional.
# Get a key at https://openrouter.ai/keys. Without one, /api/diagnose
# returns { unavailable: true } and the checker runs the offline rule
# engine instead, so the feature never breaks — it just gets smarter
# when a key is present.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Primary model. Default: NVIDIA Nemotron 3 Ultra (550B A55B).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Comma-separated backups OpenRouter falls through to on error/rate-limit.
OPENROUTER_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b

# ── Provider registration lookup (autofill on doctor/nurse signup) ──
# Entering a council registration number can pull the practitioner's name,
# qualification, council and year straight off the register.
#
# With NOTHING set below it still works: it falls back to the NMC's free
# public register. That is real data but an undocumented endpoint, so treat a
# match as a convenience — ops still confirms before anyone is marked verified.
#
# Set these to put a paid verification vendor in front of it (IDfy, Signzy,
# Karza/Perfios, HyperVerge — roughly ₹5–25 per check). The vendor is used
# first and the free register becomes the fallback. No code change needed.
REGISTRY_API_URL=
REGISTRY_API_KEY=
# Optional. Header the vendor wants the key in; defaults to Authorization
# (sent as "Bearer <key>"). Any other value is sent as the raw key.
REGISTRY_API_HEADER=
# Optional. Name shown to ops beside a match, e.g. IDfy.
REGISTRY_API_NAME=
