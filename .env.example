# ─────────────────────────────────────────────────────────────
# Iyashi — environment
# Copy to `.env.local` and fill in. The app RUNS WITHOUT any of these
# (demo mode: seeded data + in-browser store, zero setup). Add the Neo4j
# block below to switch to the real backend with accounts and login.
# ─────────────────────────────────────────────────────────────

# Turn on the Neo4j-backed live mode (accounts, login, graph data).
# Leave unset for demo mode.
NEXT_PUBLIC_BACKEND=

# Neo4j connection (server-only — never exposed to the browser).
# Use a free Neo4j Aura instance: https://neo4j.com/cloud/aura/
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Secret used to sign session tokens (any long random string).
AUTH_SECRET=

# One-time setup token — required to call POST /api/admin/seed.
SETUP_TOKEN=

# Seeded ops (admin) login, created by the setup route.
OPS_EMAIL=ops@iyashi.health
OPS_PASSWORD=change-me

# Canonical app URL (used for links). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How much the demo engine seeds (demo mode only):
#   catalog (default) — doctors/ambulances/stores only, NO activity
#   full              — also adds sample SOS/consults/orders (showcase)
#   none              — completely empty
NEXT_PUBLIC_SEED=catalog
