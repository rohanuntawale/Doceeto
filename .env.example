# ─────────────────────────────────────────────────────────────
# Iyashi Dashboard — environment
# Copy to `.env.local` and fill in. The app RUNS WITHOUT these
# (demo mode with seeded data + simulated realtime). Add them to
# switch to the live Supabase backend.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app URL (used for auth redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How much the local (no-Supabase) engine seeds:
#   catalog (default) — doctors/ambulances/stores only, NO activity (test-clean)
#   full              — also adds sample SOS/consults/orders (showcase)
#   none              — completely empty
NEXT_PUBLIC_SEED=catalog
